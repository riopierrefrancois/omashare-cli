#!/usr/bin/env python3
"""omashare: turn a video file into a share link on your OmaShare server.

  omashare login [SERVER]     sign in once (opens your browser)
  omashare FILE [--name N]    upload FILE, print the share link, copy it
  omashare status             show which server and account you use
  omashare logout             forget the saved key

Apps call `omashare --json FILE`. Each stdout line is one JSON event:
  {"event":"progress","stage":"preparing"|"uploading","percent":42.0}
  {"event":"done","id":"...","link":"https://..."}
  {"event":"error","error":"..."}
"""

import argparse
import glob
import http.client
import http.server
import json
import os
import queue
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser

VERSION = "0.1.2"
CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "omashare"
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
DEFAULT_SERVER = "http://localhost:3000"
CHUNK = 1024 * 1024
JSON_MODE = False


class ShareError(Exception):
    pass


# ---------- output ----------

def emit(obj):
    if JSON_MODE:
        print(json.dumps(obj), flush=True)


def say(msg):
    if not JSON_MODE:
        print(msg, file=sys.stderr, flush=True)


def progress(stage, percent):
    if JSON_MODE:
        emit({"event": "progress", "stage": stage, "percent": round(percent, 1)})
    else:
        sys.stderr.write(f"\r{stage.capitalize()}… {percent:5.1f}%")
        sys.stderr.flush()


def warn(message):
    if JSON_MODE:
        emit({"event": "warning", "message": message})
    else:
        say(f"Warning: {message}")


# ---------- config ----------

def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_config(cfg):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def credentials():
    cfg = load_config()
    server = os.environ.get("OMASHARE_SERVER") or cfg.get("server")
    key = os.environ.get("OMASHARE_KEY") or cfg.get("api_key")
    if not server or not key:
        raise ShareError("Not signed in. Run: omashare login")
    return server.rstrip("/"), key


# ---------- login ----------

def cmd_login(server):
    server = (server or load_config().get("server") or DEFAULT_SERVER).rstrip("/")
    result = {}
    done = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("type") == ["api_key"] and q.get("api_key"):
                result["api_key"] = q["api_key"][0]
                result["user_id"] = q.get("user_id", [""])[0]
                body = b"<h2>Signed in to OmaShare.</h2><p>You can close this tab.</p>"
                self.send_response(200)
            else:
                body = b"<h2>Sign-in failed.</h2><p>Run omashare login again.</p>"
                self.send_response(400)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            if result:
                done.set()

        def log_message(self, *args):
            pass

    httpd = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    port = httpd.server_address[1]
    threading.Thread(target=httpd.serve_forever, daemon=True).start()

    url = f"{server}/api/desktop/session/request?" + urllib.parse.urlencode(
        {"port": port, "platform": "web", "type": "api_key"}
    )
    print(f"Opening your browser to sign in to {server}…", file=sys.stderr)
    print(f"If it does not open, visit:\n  {url}", file=sys.stderr)
    webbrowser.open(url)

    if not done.wait(timeout=300):
        httpd.shutdown()
        raise ShareError("Timed out waiting for sign-in (5 minutes).")
    httpd.shutdown()

    cfg = load_config()
    cfg.update({"server": server, "api_key": result["api_key"], "user_id": result["user_id"]})
    save_config(cfg)
    print(f"Signed in. Key saved to {CONFIG_PATH}", file=sys.stderr)


def cmd_status():
    cfg = load_config()
    if not cfg.get("api_key"):
        print("Not signed in. Run: omashare login")
        return
    print(f"Server: {cfg.get('server')}")
    print(f"User:   {cfg.get('user_id')}")


def cmd_logout():
    cfg = load_config()
    cfg.pop("api_key", None)
    cfg.pop("user_id", None)
    save_config(cfg)
    print("Signed out (server address kept).", file=sys.stderr)


# ---------- media ----------

def probe(path):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-print_format", "json",
             "-show_format", "-show_streams", path],
            capture_output=True, text=True, check=True,
        ).stdout
    except FileNotFoundError:
        raise ShareError("ffprobe is missing (install ffmpeg).")
    except subprocess.CalledProcessError as e:
        raise ShareError(f"Can't read {path}: {e.stderr.strip() or 'not a video'}")
    info = json.loads(out)
    video = next((s for s in info.get("streams", []) if s.get("codec_type") == "video"), None)
    audio = next((s for s in info.get("streams", []) if s.get("codec_type") == "audio"), None)
    if not video:
        raise ShareError(f"{path} has no video track.")
    fps = 30.0
    rate = video.get("avg_frame_rate") or video.get("r_frame_rate") or "30/1"
    try:
        n, d = rate.split("/")
        if float(d):
            fps = float(n) / float(d)
    except ValueError:
        pass
    return {
        "format": info.get("format", {}).get("format_name", ""),
        "duration": float(info.get("format", {}).get("duration") or video.get("duration") or 0),
        "width": int(video.get("width") or 0),
        "height": int(video.get("height") or 0),
        "fps": round(fps, 3),
        "vcodec": video.get("codec_name", ""),
        "pix_fmt": video.get("pix_fmt", ""),
        "acodec": audio.get("codec_name", "") if audio else None,
    }


def browser_ready(meta):
    """True when the file can go up as-is: MP4 with H.264 (8-bit 4:2:0) and AAC or no audio."""
    return (
        "mp4" in meta["format"]
        and meta["vcodec"] == "h264"
        and meta["pix_fmt"] in ("yuv420p", "yuvj420p")
        and meta["acodec"] in (None, "aac")
    )


def prepare(path, meta, workdir):
    """Return a path to an MP4 every browser plays, with the index at the front."""
    out = os.path.join(workdir, "result.mp4")
    if browser_ready(meta):
        cmd = ["ffmpeg", "-v", "error", "-y", "-i", path, "-map", "0:v:0", "-map", "0:a:0?",
               "-c", "copy", "-movflags", "+faststart", "-progress", "pipe:1", "-nostats", out]
    else:
        say("Converting to a format every browser plays…")
        cmd = ["ffmpeg", "-v", "error", "-y", "-i", path, "-map", "0:v:0", "-map", "0:a:0?",
               "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p",
               "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart",
               "-progress", "pipe:1", "-nostats", out]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    total_us = max(meta["duration"], 0.001) * 1_000_000
    for line in proc.stdout:
        if line.startswith("out_time_us="):
            try:
                progress("preparing", min(100.0, int(line.split("=")[1]) / total_us * 100))
            except ValueError:
                pass
    err = proc.stderr.read()
    if proc.wait() != 0:
        raise ShareError(f"ffmpeg failed: {err.strip()[-400:]}")
    progress("preparing", 100.0)
    if not JSON_MODE:
        sys.stderr.write("\n")
    return out


# ---------- transcript ----------

def parse_timestamp(value):
    parts = value.strip().replace(",", ".").split(":")
    if len(parts) not in (2, 3):
        raise ValueError("invalid cue timestamp")
    try:
        if len(parts) == 2:
            minutes, seconds = parts
            return int(minutes) * 60 + float(seconds)
        hours, minutes, seconds = parts
        return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
    except ValueError as e:
        raise ValueError("invalid cue timestamp") from e


def parse_transcript(path):
    """Read VTT or SRT, including cue identifiers and multiline cue text."""
    with open(path, encoding="utf-8-sig") as f:
        content = f.read()
    cues = []
    for block in re.split(r"\n\s*\n", content.replace("\r\n", "\n").replace("\r", "\n")):
        lines = block.strip().splitlines()
        timing = next((i for i, line in enumerate(lines) if "-->" in line), None)
        if timing is None:
            continue
        start, end = lines[timing].split("-->", 1)
        try:
            begin = parse_timestamp(start)
            finish = parse_timestamp(end.split()[0])
        except ValueError:
            continue
        text = " ".join(line.strip() for line in lines[timing + 1:] if line.strip())
        if text and finish > begin:
            cues.append((begin, finish, text))
    return cues


WHISPER_SCRIPT = """
import json
import sys
from faster_whisper import WhisperModel
model = WhisperModel(sys.argv[1], device="cpu", compute_type="int8")
segments, _ = model.transcribe(sys.argv[2], vad_filter=True)
duration = float(sys.argv[3])
for segment in segments:
    print(json.dumps({"start": segment.start, "end": segment.end,
                      "text": segment.text.strip()}), flush=True)
    print(json.dumps({"progress": min(100, segment.end / duration * 100)}), flush=True)
"""


def whisper_setup():
    settings = {}
    settings_path = os.path.expanduser("~/.config/omaedit/settings.json")
    try:
        with open(settings_path) as f:
            settings = json.load(f)
    except (OSError, ValueError):
        pass
    python = os.environ.get("OMASHARE_WHISPER_PYTHON") or settings.get("whisperPython")
    if not python:
        for candidate in sorted(glob.glob(os.path.expanduser("~/.local/share/*/venv/bin/python"))):
            if subprocess.run([candidate, "-c", "import faster_whisper"],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                python = candidate
                break
    model = os.environ.get("OMASHARE_WHISPER_MODEL") or settings.get("whisperModel") or "small.en"
    return python, model


def get_transcript(path, meta, workdir, transcript=None, on_progress=None):
    """Return (start, end, text) cues, or None when no transcription is available."""
    base = os.path.splitext(path)[0]
    source = transcript or next(
        (candidate for candidate in (base + ".vtt", base + ".srt") if os.path.isfile(candidate)),
        None,
    )
    if source:
        return parse_transcript(source)
    if not meta["acodec"]:
        return None
    python, model = whisper_setup()
    if not python:
        return None
    wav = os.path.join(workdir, "speech.wav")
    extracted = subprocess.run(
        ["ffmpeg", "-v", "error", "-y", "-i", path, "-vn", "-ac", "1",
         "-ar", "16000", wav], capture_output=True, text=True,
    )
    if extracted.returncode:
        raise ShareError(f"Couldn't extract audio: {extracted.stderr.strip()[-300:]}")
    env = os.environ.copy()
    hf_home = os.path.expanduser("~/.local/share/omaedit/speech/hf")
    if os.path.isdir(hf_home):
        env["HF_HOME"] = hf_home
    cmd = [python, "-u", "-c", WHISPER_SCRIPT, str(model), wav,
           str(max(meta["duration"], 0.001))]
    if shutil.which("systemd-run"):
        cmd = ["systemd-run", "--user", "--scope", "-p", "MemoryMax=3G", "--quiet", *cmd]
    cues = []
    with subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          text=True, env=env) as proc:
        for line in proc.stdout:
            item = json.loads(line)
            if "progress" in item:
                if on_progress:
                    on_progress(float(item["progress"]))
            else:
                cues.append((float(item["start"]), float(item["end"]), item["text"]))
        err = proc.stderr.read()
        if proc.wait():
            raise ShareError(f"Whisper failed: {err.strip()[-300:]}")
    return cues


# ---------- writing ----------

DETAILS_SCHEMA = {
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "chapters": {"type": "array", "items": {"type": "object", "properties": {
            "title": {"type": "string"}, "start": {"type": "number"},
        }, "required": ["title", "start"]}},
    },
    "required": ["title", "summary", "chapters"],
}


def clean_details(details, duration):
    if not isinstance(details["title"], str) or not isinstance(details["summary"], str):
        raise ValueError("invalid writer response")
    title = details["title"].strip()[:200]
    summary = details["summary"].strip()
    if not title:
        raise ValueError("empty title")
    chapters = []
    for chapter in details["chapters"]:
        start = chapter["start"]
        if (not isinstance(start, (int, float)) or isinstance(start, bool)
                or not 0 <= start < duration or
                (chapters and start <= chapters[-1]["start"])):
            continue
        chapters.append({"title": str(chapter["title"]).strip(), "start": start})
    if chapters:
        chapters[0]["start"] = 0
    return {"title": title, "summary": summary, "chapters": chapters}


def write_details(cues, duration, fallback_name):
    """Ask the configured writer for share-page metadata; return None on failure."""
    writer = os.environ.get("OMASHARE_WRITER", "grok").lower()
    if writer == "off":
        return None
    if writer not in ("grok", "claude"):
        warn(f"Unknown writer {writer}; skipping summary.")
        return None
    prompt = (
        "You are naming a video someone is about to share with a link. "
        f"Below is its transcript with start times in seconds. Video length: {duration} seconds.\n"
        "Write: a title (under 70 characters, plain everyday words, sentence case, "
        "says what the viewer will learn or see, no emoji, no clickbait, no quotes); "
        'a summary (2 to 4 short sentences, plain words, written to the viewer, no "In this video"); '
        "chapters (only if the video is longer than 2 minutes: 3 to 8 chapters, "
        "the first starts at 0, each at least 30 seconds after the previous, "
        "starts are whole seconds taken from the transcript, short plain titles). "
        "Use the speaker's own words where you can. Shorter videos: chapters is an empty list.\n"
        "Transcript:\n"
        + "\n".join(f"[{start:g}] {text}" for start, _, text in cues)
    )
    # Both CLIs accept the prompt on stdin, avoiding the OS argument-length limit.
    cmd = (["grok", "-p", "--disable-web-search", "--output-format", "json",
            "--json-schema", json.dumps(DETAILS_SCHEMA)]
           if writer == "grok" else
           ["claude", "-p", "--output-format", "json", "--model", "haiku"])
    progress("writing", 0.0)
    try:
        with tempfile.TemporaryDirectory(prefix="omashare-writer-") as empty:
            proc = subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                                  cwd=empty, timeout=180, check=True)
        response = json.loads(proc.stdout)
        details = json.loads(response["text" if writer == "grok" else "result"])
        cleaned = clean_details(details, duration)
        progress("writing", 100.0)
        return cleaned
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        warn("Couldn't write a summary: Grok didn't answer." if writer == "grok"
             else "Couldn't write a summary: Claude didn't answer.")
        return None


# ---------- server API ----------

def api(server, key, method, path, query=None, body=None):
    url = server + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {key}")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        if e.code == 401:
            raise ShareError("The server didn't accept your key. Run: omashare login")
        raise ShareError(f"Server said {e.code} on {path}: {detail}")
    except urllib.error.URLError as e:
        raise ShareError(f"Can't reach {server}: {e.reason}")


def put_file(url, path, content_type="video/mp4", report=True):
    parts = urllib.parse.urlsplit(url)
    conn_cls = http.client.HTTPSConnection if parts.scheme == "https" else http.client.HTTPConnection
    conn = conn_cls(parts.netloc, timeout=120)
    target = parts.path + ("?" + parts.query if parts.query else "")
    size = os.path.getsize(path)
    conn.putrequest("PUT", target, skip_accept_encoding=True)
    conn.putheader("Content-Length", str(size))
    conn.putheader("Content-Type", content_type)
    conn.endheaders()
    sent, last = 0, 0.0
    with open(path, "rb") as f:
        while chunk := f.read(CHUNK):
            conn.send(chunk)
            sent += len(chunk)
            now = time.monotonic()
            if report and (now - last > 0.25 or sent == size):
                progress("uploading", sent / size * 100 if size else 100)
                last = now
    resp = conn.getresponse()
    body = resp.read().decode(errors="replace")
    conn.close()
    if report and not JSON_MODE:
        sys.stderr.write("\n")
    if resp.status >= 300:
        raise ShareError(f"Storage refused the upload ({resp.status}): {body[:300]}")


def make_thumbnail(path, meta, workdir):
    """One frame (1 s in, or the middle of a short video) as a JPEG, 1280 px wide at most."""
    out = os.path.join(workdir, "screen-capture.jpg")
    at = min(1.0, max(meta["duration"], 0) / 2)
    cmd = ["ffmpeg", "-v", "error", "-y", "-ss", f"{at:.3f}", "-i", path, "-frames:v", "1",
           "-vf", "scale='min(1280,iw)':-2", "-q:v", "3", out]
    done = subprocess.run(cmd, capture_output=True)
    return out if done.returncode == 0 and os.path.isfile(out) else None


def upload_thumbnail(server, key, video_id, path, meta, workdir):
    """The dashboard and link previews use this picture. A failure here never fails the share."""
    try:
        thumb = make_thumbnail(path, meta, workdir)
        if not thumb:
            return
        signed = api(server, key, "POST", "/api/upload/signed",
                     body={"videoId": video_id, "subpath": "screenshot/screen-capture.jpg", "method": "put"})
        put_file(signed["presignedPutData"]["url"], thumb, "image/jpeg", report=False)
    except ShareError as e:
        if not JSON_MODE:
            say(f"No thumbnail: {e}")


def cmd_upload(path, name, copy, transcript=None, no_details=False):
    if not os.path.isfile(path):
        raise ShareError(f"No such file: {path}")
    server, key = credentials()
    meta = probe(path)
    title = name or os.path.splitext(os.path.basename(path))[0]

    with tempfile.TemporaryDirectory(prefix="omashare-") as work:
        mp4 = prepare(path, meta, work)
        result = {}
        updates = queue.Queue()
        worker = None
        if not no_details:
            def transcribe():
                try:
                    result["cues"] = get_transcript(
                        path, meta, work, transcript, updates.put,
                    )
                except Exception as e:
                    result["error"] = str(e)

            worker = threading.Thread(target=transcribe)
            worker.start()
        try:
            dims = {
                "durationInSecs": round(meta["duration"], 3),
                "width": meta["width"],
                "height": meta["height"],
                "fps": meta["fps"],
            }
            created = api(server, key, "GET", "/api/desktop/video/create",
                           query={"recordingMode": "desktopMP4", "name": title, **dims})
            video_id = created["id"]
            signed = api(server, key, "POST", "/api/upload/signed",
                          body={"videoId": video_id, "subpath": "result.mp4", "method": "put", **dims})
            put_file(signed["presignedPutData"]["url"], mp4)
            upload_thumbnail(server, key, video_id, mp4, meta, work)
        finally:
            if worker:
                if worker.is_alive():
                    progress("transcribing", 0.0)
                while worker.is_alive():
                    try:
                        percent = updates.get(timeout=0.2)
                        progress("transcribing", percent)
                    except queue.Empty:
                        pass
                worker.join()
                if "error" in result:
                    warn(f"Couldn't transcribe: {result['error']}")
                elif result.get("cues") is None and meta["acodec"] and not transcript:
                    warn("No transcript: Whisper isn't set up on this computer.")

    link = created.get("share_url") or f"{server}/s/{video_id}"
    if copy and shutil.which("wl-copy"):
        subprocess.run(["wl-copy", link], check=False)
    if JSON_MODE:
        emit({"event": "done", "id": video_id, "link": link})
    else:
        print(link)
        if copy and shutil.which("wl-copy"):
            say("Link copied.")


# ---------- main ----------

def main():
    global JSON_MODE
    argv = sys.argv[1:]
    commands = {"login", "logout", "status", "upload"}
    # `omashare [--json] [--name T] FILE` is the short form of `omashare [--json] upload [--name T] FILE`.
    # "upload" goes right after the global flags, so upload's own options (--name, --no-copy) follow it.
    global_flags = {"--json", "--version", "-h", "--help"}
    first = next((i for i, a in enumerate(argv) if a not in global_flags), None)
    if first is not None and argv[first] not in commands:
        argv.insert(first, "upload")

    p = argparse.ArgumentParser(prog="omashare", description="Share a video as a link.")
    p.add_argument("--json", action="store_true", help="JSON events on stdout (for apps)")
    p.add_argument("--version", action="version", version=f"omashare {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    lp = sub.add_parser("login", help="sign in to your OmaShare server")
    lp.add_argument("server", nargs="?", help=f"server address (default {DEFAULT_SERVER})")
    sub.add_parser("logout", help="forget the saved key")
    sub.add_parser("status", help="show server and account")
    up = sub.add_parser("upload", help="upload a video and print its link")
    up.add_argument("file")
    up.add_argument("--name", help="title shown on the share page (default: file name)")
    up.add_argument("--no-copy", action="store_true", help="don't copy the link")
    up.add_argument("--json", action="store_true", dest="json_sub", help=argparse.SUPPRESS)
    args = p.parse_args(argv)
    JSON_MODE = args.json or getattr(args, "json_sub", False)

    try:
        if args.cmd == "login":
            cmd_login(args.server)
        elif args.cmd == "logout":
            cmd_logout()
        elif args.cmd == "status":
            cmd_status()
        elif args.cmd == "upload":
            cmd_upload(args.file, args.name, not args.no_copy)
        else:
            p.print_help()
            return 1
    except ShareError as e:
        if JSON_MODE:
            emit({"event": "error", "error": str(e)})
        else:
            print(f"omashare: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
